void MLApp::handleSelfMsg(cMessage* msg) {
    switch (msg->getKind()) {

        case SEND_BEACON_EVT: {
            DemoSafetyMessage* bsm = new DemoSafetyMessage();
            populateWSM(bsm);

            std::string sendID = traciVehicle->getVehicleId() + ";" + std::to_string(self);
            bsm->setName(sendID.c_str());
            bsm->setSpeed(traciVehicle->getSpeed());

            double maxSpeed = traci->lane(traciVehicle->getLaneId()).getMaxSpeed();
            bsm->setMaxSpeed(maxSpeed);
            bsm->setModelVersion(modelVersion);
            bsm->setLoss(lossModel);
            bsm->setComputationCapability(computationCapability);

            long uniqueMsgId = ++globalMessageCounter;
            bsm->setMsgId(uniqueMsgId);


            sendDown(bsm);
            scheduleAt(simTime() + beaconInterval, sendBeaconEvt);

            logToFile("SENT | MsgID: " + std::to_string(uniqueMsgId) +
                      " | Time: " + std::to_string(simTime().dbl()));
            break;
        }

        case TRAIN_LOCAL_MODEL_EVT: {


            if (dynamicEpoch) {
                epochs = 1;
                std::tie(numExamples, entropy, lossModel, accuracyModel, outputMSG) = client->fit(self, model, dataset, scenario, seed, nonIID, idModel, trainFlag, epochs, batch, numClients, percentDataset, "", "");

                epochs = std::floor((roundDeadline * computationCapability) / (double(numExamples) * computationRequirement));
                if (epochs <= 0) epochs = 1;

                std::tie(numExamples, entropy, lossModel, accuracyModel, outputMSG) = client->fit(self, model, dataset, scenario, seed, nonIID, idModel, trainFlag, epochs, batch, numClients, percentDataset, "", "dynamicEpoch");
                epochs = std::stoi(client->splitSTR(client->splitSTR(outputMSG, ';')[1], '=')[1]);
            } else {
                epochs = par("epochs").intValue();
                std::tie(numExamples, entropy, lossModel, accuracyModel, outputMSG) = client->fit(self, model, dataset, scenario, seed, nonIID, idModel, trainFlag, epochs, batch, numClients, percentDataset, "", "");
            }

            modelSize = std::stod(client->splitSTR(client->splitSTR(outputMSG, ';')[0], '=')[1]);

            emit(datasetTrainUpdateMetric, dataset2Number[dataset.c_str()]);
            emit(lossTrainMetric, (double)lossModel);
            emit(accuracyTrainMetric, (double)accuracyModel);

            //std::tie(numExamples, entropy, lossModel, accuracyModel, outputMSG) = client->evaluate(self, model, dataset, scenario, seed, nonIID, idModel, trainFlag, epochs, batch, numClients, percentDataset, "", "");



            // ===================== AVALIAÇÃO COM MÉTRICAS COMPLETAS =====================

            std::tie(numExamples, entropy, lossModel, accuracyModel, outputMSG) =
                client->evaluate(self, model, dataset, scenario, seed, nonIID,
                                 idModel, trainFlag, epochs, batch,
                                 numClients, percentDataset, "", "");

            // ===================== EXTRAIR MÉTRICAS DO PYTHON =====================

            double precision = 0.0;
            double recall = 0.0;
            double f1 = 0.0;
            double mcc = 0.0;
            double roc_auc = 0.0;

            std::vector<std::string> metrics = client->splitSTR(outputMSG, ';');

            for (auto &m : metrics) {
                if (m.find("precision=") != std::string::npos)
                    precision = std::stod(client->splitSTR(m, '=')[1]);

                if (m.find("recall=") != std::string::npos)
                    recall = std::stod(client->splitSTR(m, '=')[1]);

                if (m.find("f1=") != std::string::npos)
                    f1 = std::stod(client->splitSTR(m, '=')[1]);

                if (m.find("mcc=") != std::string::npos)
                    mcc = std::stod(client->splitSTR(m, '=')[1]);

                if (m.find("roc_auc=") != std::string::npos)
                    roc_auc = std::stod(client->splitSTR(m, '=')[1]);
            }

            // ===================== EMITIR MÉTRICAS COMO SIGNAL =====================

            emit(lossEvaluateMetric, (double)lossModel);
            emit(accuracyEvaluateMetric, (double)accuracyModel);

            // ===================== SALVAR EM ARQUIVO DO VEÍCULO =====================

            logToFile(
                "METRICS | Time: " + std::to_string(simTime().dbl()) +
                " | Precision: " + std::to_string(precision) +
                " | Recall: " + std::to_string(recall) +
                " | F1: " + std::to_string(f1) +
                " | MCC: " + std::to_string(mcc) +
                " | ROC_AUC: " + std::to_string(roc_auc)
            );

            // ============================================================================
            emit(datasetEvaluateUpdateMetric, dataset2Number[dataset.c_str()]);
            emit(lossEvaluateMetric, (double)lossModel);
            emit(accuracyEvaluateMetric, (double)accuracyModel);           
            
            trainingLatency = ((double(numExamples) * computationRequirement) / computationCapability) * epochs;
            if (dynamicEpoch) trainingLatency += uniform(0, 0.01);

            emit(trainLatencyMetric, (double)trainingLatency);

            // Criando e enviando o modelo local
            FlexeMessage* flexe_msg = new FlexeMessage();
            DemoBaseApplLayer::populateWSM(flexe_msg);
            long uniqueMsgId = ++globalMessageCounter;
            flexe_msg->setMsgId(uniqueMsgId);

            flexe_msg->setSenderID(self);
            flexe_msg->setModel(model.c_str());
            flexe_msg->setDataset(dataset.c_str());
            flexe_msg->setScenario(scenario.c_str());
            flexe_msg->setSeed(seed);
            flexe_msg->setNonIID(nonIID);
            flexe_msg->setNumExamples(numExamples);
            flexe_msg->setIdModel(idModel);
            flexe_msg->setModelVersion(modelVersion);
            flexe_msg->setLoss(lossModel);
            flexe_msg->setAccuracy(accuracyModel);
            flexe_msg->setF1Score(f1);
            flexe_msg->setComputationCapability(computationCapability);
            flexe_msg->setEntropy(entropy);

            if (trainingLatency < 0) {
                EV << "WARNING: trainingLatency negativo ("
                   << trainingLatency << "), ajustando para 0\n";
                trainingLatency = 0;
            }

            DemoBaseApplLayer::sendDown(flexe_msg);

            logToFile(
                "MODEL_LOCAL_SEND"
                " | Vehicle: " + std::to_string(self) +
                " | MsgID: " + std::to_string(uniqueMsgId) +
                " | Time: " + std::to_string(simTime().dbl())
            );

            logToFile(
                "MODEL_SEND"
                " | Vehicle: " + std::to_string(self) +
                " | MsgID: " + std::to_string(uniqueMsgId) +
                " | Time: " + std::to_string(simTime().dbl())
            );

            trainFlag = false;
            break;
        }

        case RESOURCE_REQUEST_EVT: {

            long uniqueMsgId = ++globalMessageCounter;


            std::tie(numExamples, entropy, lossModel, accuracyModel, outputMSG) = client->get_information(self, model, dataset, scenario, seed, nonIID, idModel, "");
            
            FlexeMessage* flexe_msg_res = new FlexeMessage();
            DemoBaseApplLayer::populateWSM(flexe_msg_res);
            flexe_msg_res->setKind(RESOURCE_REQUEST_EVT);
            flexe_msg_res->setSenderID(self);
            flexe_msg_res->setNumExamples(numExamples);
            flexe_msg_res->setComputationCapability(computationCapability);
            flexe_msg_res->setEntropy(entropy);

            //double delay = uniform(0, 0.01);
            //DemoBaseApplLayer::sendDelayedDown(flexe_msg_res, delay);
            DemoBaseApplLayer::sendDown(flexe_msg_res);
            logToFile("SENT | MsgID: " + std::to_string(uniqueMsgId) +
                      " | Time: " + std::to_string(simTime().dbl()));

            resourceFlag = false;
            break;
        }

        default:
            // Caso queira tratar mensagens desconhecidas
            break;
    }
}


void MLApp::handlePositionUpdate(cObject* obj){
    if(speedZero){
        traciVehicle->setSpeed(0.0);
    }
    DemoBaseApplLayer::handlePositionUpdate(obj);
}


void MLApp::logToFile(const std::string& line) {
    std::ofstream file(vehicleLogFile, std::ios::app);
    if (file.is_open()) {
        file << line << "\n";
        file.close();
    }
}

