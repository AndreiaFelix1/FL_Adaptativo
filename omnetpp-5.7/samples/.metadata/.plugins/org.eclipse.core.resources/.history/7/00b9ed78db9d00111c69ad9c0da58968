void FedLimRSU11p::handleSelfMsg(cMessage* msg){
    switch(msg->getKind()){
    case AGGREGATE_MODELS_EVT:{

        std::cout << self
                  << " (RSU|handleSelfMsg) AGGREGATE_MODELS_EVT "
                  << simTime().dbl()
                  << endl;

        double maxLatency = 0.0;

        // CALCULAR PDR E LATÊNCIA
        for(auto &entry : clientCommunicationMap){

            int clientId = entry.first;

            int sent =
                entry.second.messagesSent;

            int received =
                entry.second.messagesReceived;

            if(sent > 0){
                entry.second.pdr =
                    (double)received / sent;
            }
            else{
                entry.second.pdr = 0.0;
            }

            if(entry.second.latencyCount > 0){

                entry.second.averageLatency =
                    entry.second.totalLatency /
                    entry.second.latencyCount;

                if(entry.second.averageLatency > maxLatency){
                    maxLatency =
                        entry.second.averageLatency;
                }
            }
            else{
                entry.second.averageLatency = 0.0;
            }

            logCommunication(
                "Vehicle_" + std::to_string(clientId),
                -1,
                simTime().dbl(),
                "COMMUNICATION_METRICS"
                " | Round: " + std::to_string(currentRound) +
                " | Sent: " + std::to_string(sent) +
                " | Received: " + std::to_string(received) +
                " | PDR: " + std::to_string(entry.second.pdr) +
                " | AvgLatency: " +
                    std::to_string(entry.second.averageLatency)
            );
        }

        for(auto &entry : clientCommunicationMap){

            int clientId = entry.first;

            double f1 = 0.0;

            if(clientF1Map.find(clientId) != clientF1Map.end()){
                f1 = clientF1Map[clientId];
            }

            double pdr =
                entry.second.pdr;

            double latencyScore = 0.0;

            if(maxLatency > 0.0){

                latencyScore =
                    1.0 -
                    (entry.second.averageLatency / maxLatency);

            }
            else{

                latencyScore = 1.0;
            }

            double qualityScore =
                0.50 * f1 +
                0.25 * pdr +
                0.25 * latencyScore;

            entry.second.qualityScore =
                qualityScore;

            logCommunication(
                "Vehicle_" + std::to_string(clientId),
                -1,
                simTime().dbl(),
                "DATA_QUALITY"
                " | Round: " + std::to_string(currentRound) +
                " | F1: " + std::to_string(f1) +
                " | PDR: " + std::to_string(pdr) +
                " | LatencyScore: " +
                    std::to_string(latencyScore) +
                " | DQScore: " +
                    std::to_string(qualityScore)
            );
        }

            for(auto &entry : clientCommunicationMap){

                entry.second.messagesSent = 0;
                entry.second.messagesReceived = 0;
                entry.second.totalLatency = 0.0;
                entry.second.latencyCount = 0;
                entry.second.pdr = 0.0;
                entry.second.averageLatency = 0.0;

                // NÃO apagar:
                // entry.second.qualityScore
            }

        if(receivedModelsVector.size() != 0){

            logRound(
                "ROUND_AGGREGATION"
                " | RSU: " + std::to_string(self) +
                " | Round: " + std::to_string(currentRound) +
                " | Time: " + std::to_string(simTime().dbl())
            );

            clientsModels = "";
            numExamplesModels = "";

            for(std::vector<int>::iterator it =
                    receivedModelsVector.begin();
                it != receivedModelsVector.end();
                it++){

                clientsModels =
                    clientsModels + ";" + std::to_string(*it);

                emit(receivedClientsMetric, (int)*it);
            }

            for(std::vector<int>::iterator it =
                    receivedNumberExamplesVector.begin();
                it != receivedNumberExamplesVector.end();
                it++){

                numExamplesModels =
                    numExamplesModels + ";" + std::to_string(*it);
            }

            emit(roundMetric, (double)roundDeadline);

            std::tie(numExamples, entropy, lossModel, accuracyModel, outputMSG) = client->aggregate_sync_fit(self, model, dataset, scenario, seed, nonIID, idModel, numClients, numExamplesModels, clientsModels, strategy, "NULL");
            emit(lossTrainMetric, (double)lossModel);
            emit(accuracyTrainMetric, (double)accuracyModel);

            std::tie(numExamples, entropy, lossModel, accuracyModel, outputMSG) = client->aggregate_evaluate(self, model, dataset, scenario, seed, nonIID, idModel, numClients, numExamplesModels, clientsModels, strategy, "NULL");

            double precision = 0.0;
            double recall = 0.0;
            double f1 = 0.0;
            double mcc = 0.0;
            double roc_auc = 0.0;

            std::vector<std::string> metrics = client->splitSTR(outputMSG, ';');

            for (auto &m : metrics) {
                if (m.find("precision=") != std::string::npos)
                    precision = std::stod(client->splitSTR(m, '=')[1]);

                if (m.find("recall=") != std::string::npos)
                    recall = std::stod(client->splitSTR(m, '=')[1]);

                if (m.find("f1=") != std::string::npos)
                    f1 = std::stod(client->splitSTR(m, '=')[1]);

                if (m.find("mcc=") != std::string::npos)
                    mcc = std::stod(client->splitSTR(m, '=')[1]);

                if (m.find("roc_auc=") != std::string::npos)
                    roc_auc = std::stod(client->splitSTR(m, '=')[1]);
            }

            logCommunication(
                "RSU_" + std::to_string(self),
                -1,
                simTime().dbl(),
                "METRICS | Precision: " + std::to_string(precision) +
                " | Recall: " + std::to_string(recall) +
                " | F1: " + std::to_string(f1) +
                " | MCC: " + std::to_string(mcc) +
                " | ROC_AUC: " + std::to_string(roc_auc)
            );


            emit(lossEvaluateMetric, (double)lossModel);
            emit(accuracyEvaluateMetric, (double)accuracyModel);
        }
        //CLEAR DATA STRUCTURES
        receivedModelsVector.clear();
        receivedNumberExamplesVector.clear();
        //CLEAR DATA STRUCTURES
        std::cout << "\n" << endl;
        if(!clientSelectionEvt->isScheduled()){
            scheduleAt(simTime().dbl(), clientSelectionEvt);
        }
        break;
    }
    case CLIENT_SELECTION_EVT:{

        std::cout << self
                  << " (RSU|handleSelfMsg) CLIENT_SELECTION_EVT "
                  << simTime().dbl()
                  << endl;

        selectedClients = "";

        if(!connectedClientsMap.empty()){
            currentRound++;

            logRound(
                "ROUND_START"
                " | RSU: " + std::to_string(self) +
                " | Round: " + std::to_string(currentRound) +
                " | Time: " + std::to_string(simTime().dbl())
            );

            std::cout << self
                      << " (RSU|handleSelfMsg) connectedClientsMap NOT EMPTY! "
                      << " | Round: "
                      << currentRound
                      << endl;

        //selectedClients = "";
        //if(!connectedClientsMap.empty()){
            //std::cout << self << " (RSU|handleSelfMsg) connectedClientsMap NOT EMPTY! " << endl;
            //CLIENT SELECTION
            emit(connectedClientsMetric, (int)connectedClientsMap.size());
            //numSelectedClients = std::ceil(connectedClientsMap.size()*K);

            //std::cout << self << " (RSU|handleSelfMsg) N. of Connected Clients: " << connectedClientsMap.size() << endl;
            //std::cout << self << " (RSU|handleSelfMsg) N. of Selected Clients: " << numSelectedClients << endl;


            int numConnectedVehicles = 0;

            for(std::map<int, std::tuple<std::string, double, Coord>>::iterator it =
                    connectedClientsMap.begin();
                it != connectedClientsMap.end();
                ++it) {

                if(it->first < 100000){

                    numConnectedVehicles++;

                    std::cout << "Vehicle ID: "
                              << it->first
                              << " Position: "
                              << std::get<2>(connectedClientsMap[it->first])
                              << " Distance: "
                              << std::get<2>(connectedClientsMap[it->first])
                                     .distance(RSUPosition)
                              << endl;

                    connectedClientsVector.push_back(it->first);
                }
            }

            numSelectedClients = std::ceil(numConnectedVehicles * K);

            std::cout << self
                      << " (RSU|handleSelfMsg) N. of Connected Vehicles: "
                      << numConnectedVehicles
                      << endl;

            std::cout << self
                      << " (RSU|handleSelfMsg) N. of Selected Clients: "
                      << numSelectedClients
                      << endl;

            std::vector<int> remainingClients =
                connectedClientsVector;

            counter = 0;

            while(counter < numSelectedClients &&
                  !remainingClients.empty()){

                double totalQuality = 0.0;

                // Calcula a soma dos DQ dos candidatos
                for(int clientId : remainingClients){

                    double quality = 0.5;

                    if(clientCommunicationMap.find(clientId) !=
                       clientCommunicationMap.end()){

                        quality =
                            clientCommunicationMap[clientId].qualityScore;

                        // Evita peso zero
                        if(quality <= 0.0){
                            quality = 0.01;
                        }
                    }

                    totalQuality += quality;
                }

                // Sorteio proporcional ao DQ
                double randomValue =
                    ((double)std::rand() / RAND_MAX) *
                    totalQuality;

                double cumulativeQuality = 0.0;

                int selectedClient = remainingClients.back();

                for(int clientId : remainingClients){

                    double quality = 0.5;

                    if(clientCommunicationMap.find(clientId) !=
                       clientCommunicationMap.end()){

                        quality =
                            clientCommunicationMap[clientId].qualityScore;

                        if(quality <= 0.0){
                            quality = 0.01;
                        }
                    }

                    cumulativeQuality += quality;

                    if(randomValue <= cumulativeQuality){

                        selectedClient = clientId;
                        break;
                    }
                }

                // Adiciona cliente selecionado
                selectedClients =
                    selectedClients +
                    ";" +
                    std::to_string(selectedClient);

                emit(
                    selectClientsMetric,
                    selectedClient
                );

                clientCommunicationMap[selectedClient].messagesSent++;

                // Remove para não selecionar duas vezes na mesma rodada
                remainingClients.erase(
                    std::remove(
                        remainingClients.begin(),
                        remainingClients.end(),
                        selectedClient
                    ),
                    remainingClients.end()
                );

                counter++;
            }
            logRound(
                "CLIENTS_SELECTED"
                " | RSU: " + std::to_string(self) +
                " | Round: " + std::to_string(currentRound) +
                " | Clients: " + selectedClients +
                " | Time: " + std::to_string(simTime().dbl())
            );
            //CLIENT SELECTION

            //CLEAR DATA STRUCTURES
            connectedClientsMap.clear();
            connectedClientsVector.clear();
            //CLEAR DATA STRUCTURES

            //SEND GLOBAL MODEL
            FlexeMessage* flexe_msg = new FlexeMessage();
            DemoBaseApplLayer::populateWSM(flexe_msg);
            flexe_msg->setKind(SEND_GLOBAL_MODEL_EVT);
            flexe_msg->setSenderID(self);
            flexe_msg->setModel(model.c_str());
            flexe_msg->setDataset(dataset.c_str());
            flexe_msg->setScenario(scenario.c_str());
            flexe_msg->setSeed(seed);
            flexe_msg->setNonIID(nonIID);
            flexe_msg->setIdModel(idModel);
            flexe_msg->setNumClients(numClients);
            flexe_msg->setPercentDataset(percentDataset);
            flexe_msg->setModelVersion(-1);
            flexe_msg->setClientSelection(selectedClients.c_str());
            flexe_msg->setComputationRequirement(computationRequirement);
            flexe_msg->addBitLength(DemoBaseApplLayer::beaconLengthBits);

            logCommunication("RSU_" + std::to_string(self), flexe_msg->getId(), simTime().dbl(), "ENVIO");

            DemoBaseApplLayer::sendDown(flexe_msg);
            //SEND GLOBAL MODEL



            scheduleAt(simTime().dbl() + roundDeadline, aggregateModelsEvt);
        }else{
            if(!clientSelectionEvt->isScheduled()){
                scheduleAt(simTime().dbl() + 0.1, clientSelectionEvt);
            }
        }
        std::cout << "\n" << endl;
        break;
    }
    default: {
        std::cout << self << " (RSU|handleSelfMsg) - The message type was not detected. "  << msg->getKind() << endl;
        break;
    }
    }
}

void FedLimRSU11p::logCommunication(std::string node, long msgId, double timestamp, std::string type) {
        std::string path = "/home/flexe/PyFlexe/results/comunicacao_rsu/rsu_" + std::to_string(self) + ".txt";
        std::ofstream outFile;

        // Abre em modo 'app' (append) para não sobrescrever o que já foi escrito
        outFile.open(path, std::ios_base::app);
        if (outFile.is_open()) {
            outFile << "Tipo: " << type << " | Node: " << node
                    << " | MsgID: " << msgId << " | Tempo: " << timestamp << "\n";
            outFile.close();
        }
    }

void FedLimRSU11p::logRound(const std::string& message)
{
    std::string path =
        "/home/flexe/PyFlexe/results/rounds.txt";

    std::ofstream outFile(path, std::ios_base::app);

    if (outFile.is_open()) {
        outFile << message << "\n";
        outFile.close();
    }
}

