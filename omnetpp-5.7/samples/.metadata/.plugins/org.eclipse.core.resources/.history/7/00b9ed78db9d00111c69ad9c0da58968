void FedLimRSU11p::onWSM(BaseFrame1609_4* wsm){

    FlexeMessage* flexe_msg =
        check_and_cast<FlexeMessage*>(wsm);

    int senderId =
        flexe_msg->getSenderID();


    // =========================================================
    // ADICIONAR VEÍCULO À LISTA DE CLIENTES CONECTADOS
    // =========================================================

    if(senderId < 100000){

        if(connectedClientsMap.find(senderId) ==
           connectedClientsMap.end()){

            connectedClientsMap.insert(
                std::make_pair(
                    senderId,
                    std::make_tuple(
                        "unknown",
                        0.0,
                        Coord(0,0,0)
                    )
                )
            );

            EV << "RSU adicionou cliente via WSM: "
               << senderId
               << endl;
        }
    }


    // =========================================================
    // PROCESSAR TIPO DA MENSAGEM
    // =========================================================

    switch(wsm->getKind()){

        // =====================================================
        // GLOBAL MODEL
        // =====================================================

        case SEND_GLOBAL_MODEL_EVT:{

            break;
        }


        // =====================================================
        // LOCAL MODEL
        // =====================================================

        case SEND_LOCAL_MODEL_EVT:{

            FlexeMessage* flexe_msg =
                check_and_cast<FlexeMessage*>(wsm);

            int senderId =
                flexe_msg->getSenderID();

            std::cout
                << self
                << " (RSU|onWSM) SEND_LOCAL_MODEL_EVT "
                << simTime().dbl()
                << " Vehicle: "
                << senderId
                << endl;

            // ==========================================
            // 1. MÉTRICAS DE COMUNICAÇÃO
            // ==========================================

            clientCommunicationMap[senderId].messagesReceived++;

            double clientF1 =
                flexe_msg->getF1Score();

            double sendTime =
                flexe_msg->getSendTime();

            double receiveTime =
                simTime().dbl();

            double latency =
                receiveTime - sendTime;

            clientCommunicationMap[senderId].totalLatency += latency;

            clientCommunicationMap[senderId].latencyCount++;

            // ==========================================
            // 2. SALVAR F1 DO CLIENTE
            // ==========================================

            clientF1Map[senderId] =
                clientF1;

            // ==========================================
            // 3. LOG DO MODELO RECEBIDO
            // ==========================================

            logCommunication(
                "Vehicle_" + std::to_string(senderId),
                flexe_msg->getMsgId(),
                simTime().dbl(),
                "MODEL_LOCAL_RECEIVE"
                " | F1: " +
                std::to_string(clientF1)
                +
                " | Latency: " +
                std::to_string(latency)
            );

            // ==========================================
            // 4. ACEITAR MODELO PARA AGREGAÇÃO
            // ==========================================

            if(idModel == flexe_msg->getIdModel()){

                localModelID =
                    flexe_msg->getSenderID();

                if(
                    std::find(
                        receivedModelsVector.begin(),
                        receivedModelsVector.end(),
                        localModelID
                    )
                    ==
                    receivedModelsVector.end()
                ){

                    receivedModelsVector.push_back(
                        localModelID
                    );

                    receivedNumberExamplesVector.push_back(
                        flexe_msg->getNumExamples()
                    );
                }
            }

            break;
        }


        // =====================================================
        // DEFAULT
        // =====================================================

        default:{

            std::cout
                << self
                << " (RSU|onWSM) The message type "
                << "was not detected. "
                << wsm->getKind()
                << endl;

            break;
        }
    }

    std::cout << "\n" << endl;
}

